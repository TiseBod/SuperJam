--- !u!114 &468551404
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 468551402}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ddf3e54cf6263eb459010ae096084e7c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textBox: {fileID: 37080744}
  videoPlayer: {fileID: 1606678428}
  descriptions:
  - Press the W A S D keys to move around!
  - Press the space bar to jump from obstacle to obstacle
  - press spacebar while jumping to do a double jump
  - shoot a pulse to break obstacles  (obstacles you can break are normally read)
  - 'create a barrier that can break your fall, '
  - While your jumping, press C, this reduce the amount of gravity that acts on you,
    causing you to jump higher and fall slower!
  - While playing press P to pause, pretty straight forward
  - while not jumping, press left click to interact with a NPC or on object. They
    should have "interact" above them if you get close enough
  - Move your mouse/ touchpad around to change the camera angle
  - while on the ground or in the air, press R to do a little dash forward
  videoClips:
  - {fileID: 32900000, guid: 9a4584665a27f2c46b825e428c07a9d0, type: 3}
  - {fileID: 32900000, guid: f6fef65b26b84a14f8dd0e939788e3c6, type: 3}
